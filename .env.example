# GEMINI_API_KEY: NOT currently used by any code in src/ (leftover AI Studio
# scaffolding). Intentionally no longer wired into vite.config.ts's client
# bundle - if/when an AI-assisted feature is built, call Gemini from a Firebase
# Cloud Function that holds this key server-side, not from client code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
